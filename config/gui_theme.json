      "text_vert_alignment": "center"
    }
  },

  "#start_button": {
    "colours": {
      "normal_bg": "Orange",
      "normal_text": "Red",
      "normal_border": "Blue",
      "hovered_bg": "Green",
      "hovered_text": "Yellow",
      "hovered_border": "Purple",
      "active_bg": "Cyan",
      "active_text": "Purple",
      "active_border": "Red"
    },
    "font": {
      "name": "noto_sans",
      "size": "55",
      "bold": "1"
    },
    "misc": {
      "shape": "rounded_rectangle",
      "shape_corner_radius": "75",
      "border_width": "5",
      "shadow_width": "0"
    }
  },

  "#start_menu_panel": {
    "colours": {
      "dark_bg": "#FFFFFF"
    }
